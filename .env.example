DB_PASSWORD=YOUR_DB_PASSWORD
JWT_KEY=YOUR_JWT_KEY_MIN_32_CHARS
SUPERADMIN_PASSWORD=YOUR_SUPERADMIN_PASSWORD

# Twilio (WhatsApp / SMS - isteğe bağlı)
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_SMS_FROM_NUMBER=+1XXXXXXXXXX

# Netgsm SMS
NETGSM_USERCODE=YOUR_NETGSM_USERCODE
NETGSM_PASSWORD=YOUR_NETGSM_PASSWORD
NETGSM_MSGHEADER=ayarliyo

# Email (Gmail SMTP - OTP ve bildirim e-postaları için)
EMAIL_SMTP_USERNAME=info@ayarliyo.com
EMAIL_SMTP_PASSWORD=YOUR_GOOGLE_WORKSPACE_APP_PASSWORD

# Meta WhatsApp Cloud API
META_ACCESS_TOKEN=YOUR_META_WHATSAPP_ACCESS_TOKEN
META_PHONE_NUMBER_ID=1192563087266067
# Gelen webhook HMAC doğrulaması için (Meta App Dashboard → App Secret)
META_APP_SECRET=YOUR_META_APP_SECRET

# WPPConnect WhatsApp (opsiyonel, Meta kullanılıyorsa gerekmiyor)
WPPCONNECT_SECRET_KEY=THISISMYSECURETOKEN

# İyzico Ödeme
IYZICO_API_KEY=YOUR_IYZICO_API_KEY
IYZICO_SECRET_KEY=YOUR_IYZICO_SECRET_KEY

# Uygulama URL
APP_BASE_URL=https://ayarliyo.com
